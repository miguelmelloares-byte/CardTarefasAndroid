<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_header_bg"
        android:paddingStart="16dp"
        android:paddingEnd="10dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/widget_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Lista"
            android:textColor="@color/titulo"
            android:fontFamily="serif"
            android:textStyle="bold|italic"
            android:textSize="17sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_mes_ant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹"
            android:textColor="@color/blush"
            android:textStyle="bold"
            android:textSize="24sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="0dp"
            android:paddingBottom="2dp"
            android:background="@drawable/wbtn_bg"
            android:layout_marginStart="4dp"
            android:contentDescription="Mes anterior" />

        <TextView
            android:id="@+id/widget_mes_prox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="@color/blush"
            android:textStyle="bold"
            android:textSize="24sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="0dp"
            android:paddingBottom="2dp"
            android:background="@drawable/wbtn_bg"
            android:layout_marginStart="4dp"
            android:contentDescription="Proximo mes" />

        <ImageView
            android:id="@+id/widget_transito"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="6dp"
            android:src="@drawable/ic_transito"
            android:contentDescription="Itens em transito"
            android:visibility="gone" />



        <ImageView
            android:id="@+id/widget_add"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="8dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/wbtn_bg"
            android:src="@drawable/ic_add"
            android:contentDescription="Adicionar" />

        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="8dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/wbtn_bg"
            android:src="@drawable/ic_refresh"
            android:contentDescription="Atualizar" />
    </LinearLayout>

    <ListView
        android:id="@+id/widget_lista"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="6dp" />

    <TextView
        android:id="@+id/widget_vazio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="16dp"
        android:text="Sem itens.\nToque em + para adicionar."
        android:textColor="@color/dim"
        android:textSize="13sp" />
</LinearLayout>
