<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- barra de titulo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_bar"
        android:paddingStart="18dp"
        android:paddingEnd="10dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/txt"
            android:textStyle="bold"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btn_sair"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sair"
            android:padding="8dp"
            android:textColor="@color/dim"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ====== LOGIN ====== -->
    <LinearLayout
        android:id="@+id/login_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Entrar na sua conta"
            android:textColor="@color/txt"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Use o mesmo e-mail e senha do app no PC e do site."
            android:textColor="@color/dim"
            android:textSize="14sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp" />

        <EditText
            android:id="@+id/in_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="E-mail"
            android:inputType="textEmailAddress"
            android:textColor="@color/txt"
            android:textColorHint="@color/dim"
            android:background="@drawable/field_bg"
            android:padding="14dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/in_senha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Senha"
            android:inputType="textPassword"
            android:textColor="@color/txt"
            android:textColorHint="@color/dim"
            android:background="@drawable/field_bg"
            android:padding="14dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/login_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/danger"
            android:textSize="13sp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/btn_entrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Entrar"
            android:gravity="center"
            android:background="@drawable/btn_accent"
            android:textColor="#11111B"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp" />
    </LinearLayout>

    <!-- ====== LISTA ====== -->
    <LinearLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Grupo mostrado no widget"
            android:textColor="@color/dim"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp">

            <EditText
                android:id="@+id/in_grupo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Ex.: Mercado"
                android:textColor="@color/txt"
                android:textColorHint="@color/dim"
                android:background="@drawable/field_bg"
                android:padding="12dp"
                android:maxLines="1"
                android:inputType="text" />

            <TextView
                android:id="@+id/btn_grupo"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Salvar"
                android:gravity="center"
                android:background="@drawable/btn_soft"
                android:textColor="@color/txt"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/in_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Novo item..."
                android:textColor="@color/txt"
                android:textColorHint="@color/dim"
                android:background="@drawable/field_bg"
                android:padding="12dp"
                android:maxLines="1"
                android:inputType="textCapSentences" />

            <TextView
                android:id="@+id/btn_add"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Adicionar"
                android:gravity="center"
                android:background="@drawable/btn_accent"
                android:textColor="#11111B"
                android:textStyle="bold"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/dim"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/lista_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
